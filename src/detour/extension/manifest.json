{
  "manifest_version": 3,
  "name": "Detour Sentry",
  "version": "1.1.0",
  "description": "Tab-level domain isolation and User-Agent masking for tunneled websites.",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Detour Sentry",
    "default_icon": {
      "16": "icons/icon-direct-16.png",
      "32": "icons/icon-direct-32.png",
      "48": "icons/icon-direct-48.png",
      "128": "icons/icon-direct-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
