// sing-box configuration for a Linux client. detour fills in the
// placeholders from the [linux] table of its config file.
{
  "log": { "level": "warn", "timestamp": true },
  "dns": {
    "servers": [
      // the network's own resolver, learned over DHCP; fast, and it follows you to other networks
      { "type": "dhcp", "tag": "dns-direct" },
      // listed domains get an address from this range; the real lookup happens later, inside the tunnel
      { "type": "fakeip", "tag": "dns-fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18" },
      // the resolver inside the tunnel, used only for listed domains
      { "type": "udp", "tag": "dns-vpn", "server": "__TUNNEL_DNS__", "detour": "wg" }
    ],
    "rules": [
      // Firefox turns off its own DNS over HTTPS when this canary answers NXDOMAIN
      { "domain": ["use-application-dns.net"], "action": "predefined", "rcode": "NXDOMAIN" },
      // no HTTPS or SVCB records for listed domains: they could reveal real addresses
      { "rule_set": ["vpn-domains"], "query_type": ["HTTPS", "SVCB"], "action": "predefined", "rcode": "NOERROR" },
      { "rule_set": ["vpn-domains"], "query_type": ["A", "AAAA"], "action": "route", "server": "dns-fakeip" }
    ],
    "final": "dns-direct",
    "reverse_mapping": false
  },
  "inbounds": [
    // all IPv4 traffic enters here; auto_route points the IPv4 default route at this interface.
    // IPv6 is different: only the FakeIP range comes in, so IPv6 to a listed domain is still
    // refused rather than leaked, and real IPv6 goes direct when the network has it. A ::/0
    // route here would make the host believe that it has IPv6 on an IPv4-only network, and
    // every IPv6 connection would then die inside the tun (Tailscale relays were one victim).
    { "type": "tun", "tag": "tun-in", "interface_name": "sbtun0",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"], "mtu": 1420,
      "auto_route": true, "strict_route": false,
      "route_address": ["0.0.0.0/0", "fc00::/18"], "stack": "mixed" },
    // systemd-resolved sends every query here (the install adds a resolved drop-in)
    { "type": "direct", "tag": "dns-in", "listen": "127.0.0.1", "listen_port": 53 }
  ],
  "endpoints": [
    { "type": "wireguard", "tag": "wg", "system": false, "mtu": 1420,
      "address": ["__DEVICE_ADDRESS__"],
      "private_key": "__DEVICE_PRIVATE_KEY__",
      "peers": [
        { "address": "__SERVER_HOST__", "port": __SERVER_PORT__,
          "public_key": "__SERVER_PUBLIC_KEY__",
          "allowed_ips": ["0.0.0.0/0"], "persistent_keepalive_interval": 25 }
      ] }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct", "domain_resolver": "dns-direct" }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      { "type": "remote", "tag": "vpn-domains", "format": "source", "url": "__RULES_URL__",
        "http_client": "direct-client", "update_interval": "5m" }
    ],
    // order is the policy: the first matching rule wins
    "rules": [
      { "inbound": ["dns-in"], "action": "hijack-dns" },
      { "port": 53, "action": "hijack-dns" },
      // a connection to a FakeIP carries its domain: resolve the real address through the tunnel
      { "action": "resolve", "server": "dns-vpn" },
      // still a FakeIP after resolving: refuse rather than leak
      { "ip_cidr": ["198.18.0.0/15", "fc00::/18"], "action": "reject" },
      // the tunnel carries IPv4 only: refuse IPv6 to listed domains rather than send it direct
      { "ip_version": 6, "rule_set": ["vpn-domains"], "action": "reject" },
      { "rule_set": ["vpn-domains"], "action": "route", "outbound": "wg" },
      // DNS over TLS would bypass the split
      { "port": 853, "action": "reject" }
    ],
    "final": "direct"
  },
  "services": [
    { "type": "api", "tag": "api", "listen": "127.0.0.1", "listen_port": 9090,
      "secret": "__API_SECRET__",
      "access_control_allow_origin": ["http://127.0.0.1:9090", "http://localhost:9090"],
      "dashboard": { "enabled": true, "http_client": "direct-client" } }
  ],
  "experimental": { "cache_file": { "enabled": true, "store_fakeip": true } },
  // rule-set and dashboard downloads never go through the tunnel
  "http_clients": [ { "tag": "direct-client", "detour": "direct" } ]
}
